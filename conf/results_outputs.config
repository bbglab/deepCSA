/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for tunning the outputs of plots and QCs
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// TODO revise that all the outputs of these steps are properly copied to the output directory
process {

    withName: ANNOTATEDEPTHS{
        publishDir = [
                [
                    path: { "${params.outdir}/depths" },
                    mode: params.publish_dir_mode,
                    pattern: 'all_samples_indv.depths.tsv.gz'
                ],
                [
                    path: { "${params.outdir}/depths/individual" },
                    mode: params.publish_dir_mode,
                    pattern: '**{tsv.gz}',
                        saveAs: { filename -> 
                            // Exclude the main result file from this directory
                            filename == 'all_samples_indv.depths.tsv.gz' ? null : filename 
                        }
                ]
            ]
    }

    withName: DEPTHSSUMMARY{
        publishDir = [
            path: { "${params.outdir}/depths/summary" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,png}',
        ]
    }
    withName: PLOTMAF{
        publishDir = [
            path: { "${params.outdir}/plots/mutations_summary_all" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,png}',
        ]
    }
    withName: PLOTSOMATICMAF{
        publishDir = [
            path: { "${params.outdir}/plots/mutations_summary_somatic" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,png}',
        ]
    }
    withName: CONCATPROFILES{
        publishDir = [
            path: { "${params.outdir}/qc/mutational_profiles_comparison" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,png}',
        ]
    }
    withName: EVALOMEGAGLOCESTIMATION{
        publishDir = [
            path: { "${params.outdir}/qc/evaluate_omega_globalloc" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,png}',
        ]
    }
    withName: PLOTNEEDLES{
        publishDir = [
            path: { "${params.outdir}/plots/needle_plots" },
            mode: params.publish_dir_mode,
            pattern: '**{pdf}',
        ]
    }
    withName: PLOTSELECTION{
        publishDir = [
            path: { "${params.outdir}/plots/selection_summary" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,png}',
        ]
    }
    withName: PLOTSATURATION{
        publishDir = [
            path: { "${params.outdir}/plots/gene_subgenic_selection" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,png}',
        ]
    }
    withName: PLOTSATURATIONPROPORTIONS{
        publishDir = [
            path: { "${params.outdir}/plots/saturation_proportions" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,png}',
        ]
    }
    withName: PLOTINTERINDIVIDUALVARIABILITY{
        publishDir = [
            path: { "${params.outdir}/plots/interindividual_variability" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,png}',
        ]
    }
    withName: PLOTMUTATIONSPECIFIC{
        publishDir = [
            path: { "${params.outdir}/qc/mutationspecific" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,png}',
        ]
    }
    withName: PLOTMUTDENSITYQC{
        publishDir = [
            path: { "${params.outdir}/qc/mutdensityqc" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,csv,pdf,png}',
        ]
    }

    withName: APPLYOMEGAQC {
        publishDir = [
            [
                path: { "${params.outdir}/selection/omega/" },
                mode: params.publish_dir_mode,
                pattern: 'omega.flagged_annotated.tsv'
            ],
            [
                path: { "${params.outdir}/qc/omega_flagged" },
                mode: params.publish_dir_mode,
                pattern: '*.{tsv,pdf,png}',
                saveAs: { filename -> 
                    // Exclude the main result file from this directory
                    filename == 'omega.flagged_annotated.tsv' ? null : filename 
                }
            ]
        ]
    }


    withName: DNA2PROTEINMAPPING {
        publishDir = [
            path: { "${params.outdir}/regions/annotations" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,bed,pdf}',
        ]
    }

    withName: POSTPROCESSVEPPANEL {
        publishDir = [
            enabled : false
        ]
    }

    withName: 'SITESFROMPOSITIONS' {
        publishDir = [
            path: { "${params.outdir}/regions/allsites" },
            mode: params.publish_dir_mode,
            pattern: 'captured_positions.sites4VEP.full.tsv',
        ]
    }

    withName: 'SORTPANELRICH|SORTPANELRICHALL' {
        publishDir = [
            path: { "${params.outdir}/regions/annotations" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,png}',
        ]
    }

    withName: DOMAINANNOTATION {
        publishDir = [
            path: { "${params.outdir}/regions/annotations" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,bed}',
        ]
    }
    withName: CUSTOMANNOTATION {
        publishDir = [
            path: { "${params.outdir}/regions/annotations" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv}',
        ]
    }
    withName: 'CUSTOMPROCESSING.*' {
        publishDir = [
            path: { "${params.outdir}/regions/annotations" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv}',
        ]
    }

    withName: SITESFROMPOSITIONS {
        publishDir = [
            path: { "${params.outdir}/processing_files/sitesfrompositions" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv}',
        ]
    }
    withName: SUMANNOTATION {
        publishDir = [
            path: { "${params.outdir}/processing_files/sumannotation" },
            mode: params.publish_dir_mode,
            pattern: '**{tab.gz}',
        ]
    }

    withName: SYNMUTDENSITY {
        publishDir = [
            path: { "${params.outdir}/processing_files/synmutdensity" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv}',
        ]
    }
    withName: SYNMUTREADSDENSITY {
        publishDir = [
            path: { "${params.outdir}/processing_files/synmutreadsdensity" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv}',
        ]
    }

    withName: COMPUTEMATRIX {
        publishDir = [
            path: { "${params.outdir}/processing_files/computematrix" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,per_sample,sigprofiler}',
        ]
    }

    withName: COMPUTETRINUC {
        publishDir = [
            path: { "${params.outdir}/qc/trinucleotide_proportions/samples" },
            mode: params.publish_dir_mode,
            pattern: '**{png}',
        ]
    }
    withName: COMPAREPANELPROPORTIONS {
        publishDir = [
            path: { "${params.outdir}/qc/trinucleotide_proportions" },
            mode: params.publish_dir_mode,
            pattern: '**{png}',
        ]
    }
    withName: COMPUTEPROFILE {
        publishDir = [
            path: { "${params.outdir}/mutational_profile" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf}',
        ]
    }

    withName: 'BBGTOOLS:DEEPCSA:OMEGA:SITECOMPARISON' {
        publishDir = [
            path: { "${params.outdir}/selection/sitecomparison/bckg_single_count_single" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv.gz}',
        ]
    }
    withName: 'BBGTOOLS:DEEPCSA:OMEGA:SITECOMPARISONMULTI' {
        publishDir = [
            path: { "${params.outdir}/selection/sitecomparison/bckg_single_count_multi" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv.gz}',
        ]
    }
    withName: 'BBGTOOLS:DEEPCSA:OMEGA:SITECOMPARISONGLOBALLOC' {
        publishDir = [
            path: { "${params.outdir}/selection/sitecomparison/bckg_glocsingle_count_single" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv.gz}',
        ]
    }
    withName: 'BBGTOOLS:DEEPCSA:OMEGA:SITECOMPARISONGLOBALLOCMULTI' {
        publishDir = [
            path: { "${params.outdir}/selection/sitecomparison/bckg_glocsingle_count_multi" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv.gz}',
        ]
    }

    withName: 'BBGTOOLS:DEEPCSA:OMEGAMULTI:SITECOMPARISON' {
        publishDir = [
            path: { "${params.outdir}/selection/sitecomparison/bckg_multi_count_single" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv.gz}',
        ]
    }
    withName: 'BBGTOOLS:DEEPCSA:OMEGAMULTI:SITECOMPARISONMULTI' {
        publishDir = [
            path: { "${params.outdir}/selection/sitecomparison/bckg_multi_count_multi" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv.gz}',
        ]
    }
    withName: 'BBGTOOLS:DEEPCSA:OMEGAMULTI:SITECOMPARISONGLOBALLOC' {
        publishDir = [
            path: { "${params.outdir}/selection/sitecomparison/bckg_glocmulti_count_single" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv.gz}',
        ]
    }
    withName: 'BBGTOOLS:DEEPCSA:OMEGAMULTI:SITECOMPARISONGLOBALLOCMULTI' {
        publishDir = [
            path: { "${params.outdir}/selection/sitecomparison/bckg_glocmulti_count_multi" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv.gz}',
        ]
    }
    withName: 'MUTDENSITY.*' {
        publishDir = [
            path: { "${params.outdir}/mutdensity/individual_vals" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv}',
        ]
    }
    withName: 'MUTDENSITYADJ' {
        publishDir = [
            path: { "${params.outdir}/mutdensity_adjusted/individual_vals" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf}',
        ]
    }
    withName: 'CONTAMINATION' {
        publishDir = [
            path: { "${params.outdir}/qc/contamination" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf}',
        ]
    }
}
