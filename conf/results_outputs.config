/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for tunning the outputs of plots and QCs
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// TODO revise that all the outputs of these steps are properly copied to the output directory

process {

    withName: ANNOTATEDEPTHS{
        publishDir = [
            path: { "${params.outdir}/depths" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,png}',
        ]
    }
    withName: DEPTHSSUMMARY{
        publishDir = [
            path: { "${params.outdir}/plots/depths_summary" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,png}',
        ]
    }
    withName: PLOTMAF{
        publishDir = [
            path: { "${params.outdir}/plots/mutations_summary_all" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,png}',
        ]
    }
    withName: PLOTSOMATICMAF{
        publishDir = [
            path: { "${params.outdir}/plots/mutations_summary_somatic" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,png}',
        ]
    }
    withName: CONCATPROFILES{
        publishDir = [
            path: { "${params.outdir}/qc/mutational_profiles_comparison" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,png}',
        ]
    }
    withName: EVALOMEGAGLOCESTIMATION{
        publishDir = [
            path: { "${params.outdir}/qc/evaluate_omega_globalloc" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,png}',
        ]
    }
    withName: PLOTSELECTION{
        publishDir = [
            path: { "${params.outdir}/plots/selection_summary" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,png}',
        ]
    }
    withName: PLOTSATURATION{
        publishDir = [
            path: { "${params.outdir}/plots/gene_subgenic_selection" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,png}',
        ]
    }
    withName: PLOTSATURATIONPROPORTIONS{
        publishDir = [
            path: { "${params.outdir}/plots/saturation_proportions" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,png}',
        ]
    }
    withName: PLOTINTERINDIVIDUALVARIABILITY{
        publishDir = [
            path: { "${params.outdir}/plots/interindividual_variability" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,png}',
        ]
    }
    withName: PLOTMUTATIONSPECIFIC{
        publishDir = [
            path: { "${params.outdir}/qc/mutationspecific" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,png}',
        ]
    }
    withName: PLOTMUTDENSITYQC{
        publishDir = [
            path: { "${params.outdir}/qc/mutdensityqc" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,png}',
        ]
    }
    withName: APPLYOMEGAQC{
        publishDir = [
            path: { "${params.outdir}/applyomegaqc" },
            mode: params.publish_dir_mode,
            pattern: '**{tsv,pdf,png}',
        ]
    }
}
