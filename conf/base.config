process {
    // === RESOURCE LIMITS ===
    resourceLimits = [
        cpus:   params.max_cpus,
        memory: params.max_memory,
        time:   params.max_time
    ]

    // === DEFAULTS ===
    // Covers the long tail of small utility processes (peak_rss typically < 50 MB)
    cpus   = { 1 }
    memory = { 4.GB * task.attempt }
    time   = { 360.min * task.attempt }

    // === ERROR HANDLING ===
    errorStrategy = {
        if (task.exitStatus in ((130..145) + 104)) {
            sleep(Math.pow(2, task.attempt) * 200 as long)
            return 'retry'
        } else {
            return 'finish'
        }
    }
    maxRetries = 3
    maxErrors  = '-1'

    withLabel: error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    // ==========================================================================
    // VEP ANNOTATION
    // ==========================================================================

    // peak_rss 381–1,200 MB; %cpu 105–265% → VEP uses ~2.5 threads internally
    withName: 'BBGTOOLS:DEEPCSA:MUT_PREPROCESSING:VCFANNOTATE:ENSEMBLVEP_VEP' {
        cpus   = { 4 }
        memory = { 1536.MB * task.attempt }    // +28% over 1,200 MB max
    }

    // Panel chunks: peak_rss 121–1,700 MB; %cpu 1195–1908% (~12–19 cores used)
    withName: 'BBGTOOLS:DEEPCSA:CREATEPANELS:VCFANNOTATEPANEL:ENSEMBLVEP_VEP' {
        cpus   = { 24 }
        memory = { 2.GB * task.attempt }       // +21% over 1,700 MB
    }

    // ==========================================================================
    // PANEL CREATION
    // ==========================================================================

    // peak_rss 2,900 MB
    withName: 'BBGTOOLS:DEEPCSA:CREATEPANELS:SITESFROMPOSITIONS' {
        memory = { 4.GB * task.attempt }       // +41%
    }

    // peak_rss 3,300–6,100 MB
    withName: 'BBGTOOLS:DEEPCSA:CREATEPANELS:POSTPROCESSVEPPANEL' {
        memory = { 7.GB * task.attempt }       // +17%
    }

    // peak_rss 4,600 MB
    withName: 'BBGTOOLS:DEEPCSA:CREATEPANELS:CREATECAPTUREDPANELS' {
        memory = { 5.GB * task.attempt }       // +14%
    }

    // EXONS 12,200 MB; ALL 14,500 MB — %cpu ~136–148% with 4 CPUs
    withName: 'BBGTOOLS:DEEPCSA:CREATEPANELS:CREATECONSENSUSPANELSEXONS|BBGTOOLS:DEEPCSA:CREATEPANELS:CREATECONSENSUSPANELSALL' {
        cpus   = { 4 }
        memory = { 16.GB * task.attempt }      // +13% over 14,500 MB
    }

    // INTRONS 12,900 MB; SYNONYMOUS 12,300 MB; PROTAFFECT 12,500 MB; NONPROTAFFECT 14,600 MB
    withName: 'BBGTOOLS:DEEPCSA:CREATEPANELS:CREATECONSENSUSPANELSINTRONS|BBGTOOLS:DEEPCSA:CREATEPANELS:CREATECONSENSUSPANELSSYNONYMOUS|BBGTOOLS:DEEPCSA:CREATEPANELS:CREATECONSENSUSPANELSPROTAFFECT|BBGTOOLS:DEEPCSA:CREATEPANELS:CREATECONSENSUSPANELSNONPROTAFFECT' {
        cpus   = { 1 }
        memory = { 16.GB * task.attempt }      // +10% over 14,600 MB
    }

    // peak_rss 6,400 MB
    withName: 'BBGTOOLS:DEEPCSA:CREATEPANELS:CUSTOMPROCESSING' {
        memory = { 7.GB * task.attempt }       // +12%
    }

    // peak_rss 9,200 MB; %cpu 375% (8 cores used)
    withName: 'BBGTOOLS:DEEPCSA:CREATEPANELS:CUSTOMPROCESSINGRICH' {
        cpus   = { 8 }
        memory = { 10.GB * task.attempt }      // +11%
    }

    // peak_rss 5,900 MB
    withName: 'BBGTOOLS:DEEPCSA:CREATEPANELS:DOMAINANNOTATION' {
        memory = { 7.GB * task.attempt }       // +21%
    }

    // peak_rss 12–15 MB
    withName: 'BBGTOOLS:DEEPCSA:CREATEPANELS:SORTPANELCOMPACT|BBGTOOLS:DEEPCSA:CREATEPANELS:SORTPANELRICH' {
        memory = { 64.MB * task.attempt }      // +321% over 15 MB max
    }

    // peak_rss 1,000 MB
    withName: 'BBGTOOLS:DEEPCSA:CREATEPANELS:COMPAREPANELPROPORTIONS' {
        memory = { 2.GB * task.attempt }       // +105%
    }

    // ==========================================================================
    // DEPTH ANALYSIS
    // ==========================================================================

    // peak_rss 249 MB RSS (large mmap/vmem, but only RSS is capped by scheduler)
    withName: 'BBGTOOLS:DEEPCSA:DEPTHANALYSIS:COMPUTEDEPTHS' {
        cpus   = { 4 }
        memory = { 4.GB * task.attempt }
    }

    // DEPTHSEXONSCONS + DEPTHSALLCONS: peak_rss 191–238 MB across all ~560 jobs
    withName: 'BBGTOOLS:DEEPCSA:DEPTHS.*CONS' {
        memory = { 512.MB * task.attempt }     // +115% over 238 MB
    }

    // peak_rss 15,500 MB
    withName: 'BBGTOOLS:DEEPCSA:ANNOTATEDEPTHS' {
        memory = { 18.GB * task.attempt }      // +19%
    }

    // peak_rss 1,800 MB
    withName: 'BBGTOOLS:DEEPCSA:PLOTDEPTHSEXONSCONS:QUERYDEPTHS' {
        memory = { 2.GB * task.attempt }       // +14%
    }

    // peak_rss 3,500 MB; wall-clock ~79 min
    withName: 'BBGTOOLS:DEEPCSA:PLOTDEPTHSEXONSCONS:DEPTHSSUMMARY' {
        memory = { 4.GB * task.attempt }       // +17%
        time   = { 120.min * task.attempt }
    }

    // peak_rss 21 MB
    withName: 'BBGTOOLS:DEEPCSA:PLOTDEPTHSEXONSCONS:CUSTOMBEDFILE' {
        memory = { 64.MB * task.attempt }
    }

    // ==========================================================================
    // MUTATION PREPROCESSING
    // ==========================================================================

    // peak_rss 13,100 MB
    withName: 'BBGTOOLS:DEEPCSA:MUT_PREPROCESSING:SUMANNOTATION' {
        memory = { 16.GB * task.attempt }      // +25%
    }

    // peak_rss 3,800 MB; cpus=2
    withName: 'BBGTOOLS:DEEPCSA:MUT_PREPROCESSING:CUSTOMANNOTATION' {
        cpus   = { 2 }
        memory = { 5.GB * task.attempt }       // +35%
    }

    // peak_rss 942–2,400 MB
    withName: 'BBGTOOLS:DEEPCSA:MUT_PREPROCESSING:VCF2MAF' {
        memory = { 3.GB * task.attempt }       // +28%
    }

    // peak_rss 279–348 MB (per-sample only, no all_samples variant)
    withName: 'BBGTOOLS:DEEPCSA:MUT_PREPROCESSING:FILTEREXONS' {
        memory = { 512.MB * task.attempt }     // +47%
    }

    // peak_rss 505–608 MB (per-sample only, no all_samples variant)
    withName: 'BBGTOOLS:DEEPCSA:MUT_PREPROCESSING:FILTERPANEL' {
        memory = { 1.GB * task.attempt }       // +68%
    }

    // peak_rss 7,000–7,400 MB (per-sample)
    withName: 'BBGTOOLS:DEEPCSA:MUT_PREPROCESSING:FILTERNANOSEQSNP' {
        memory = { 9.GB * task.attempt }       // +25%
    }

    // peak_rss 11,700–11,900 MB (per-sample; 12 GB was only +0.8% headroom)
    withName: 'BBGTOOLS:DEEPCSA:MUT_PREPROCESSING:FILTERNANOSEQNOISE' {
        memory = { 14.GB * task.attempt }      // +19%
    }

    // peak_rss 5,600 MB (all_samples only)
    withName: 'BBGTOOLS:DEEPCSA:MUT_PREPROCESSING:MERGEBATCH' {
        memory = { 7.GB * task.attempt }       // +28%
    }

    // peak_rss 11,800 MB (all_samples only; 12 GB was only +1.7%)
    withName: 'BBGTOOLS:DEEPCSA:MUT_PREPROCESSING:FILTERBATCH' {
        memory = { 14.GB * task.attempt }      // +21%
    }

    // Per-sample ≤ 250 MB (+105% at 512 MB); all_samples 9,100 MB (+15% at 10 GB)
    withName: 'BBGTOOLS:DEEPCSA:MUT_PREPROCESSING:CLEANMUTATIONS' {
        memory = { (task.tag == 'all_samples' ? 10.GB : 512.MB) * task.attempt }
    }

    // peak_rss 1,400 MB
    withName: 'BBGTOOLS:DEEPCSA:MUT_PREPROCESSING:CREATEMASKMATRIX' {
        memory = { 2.GB * task.attempt }       // +46%
    }

    // Per-sample ≤ 178 MB (+44% at 256 MB); all_samples 3,500 MB (+20% at 4 GB)
    withName: 'BBGTOOLS:DEEPCSA:MUT_PREPROCESSING:SOMATICMUTATIONS' {
        memory = { (task.tag == 'all_samples' ? 4.GB : 256.MB) * task.attempt }
    }

    // peak_rss 9,900 MB (all_samples; 10 GB was only +1%)
    withName: 'BBGTOOLS:DEEPCSA:MUT_PREPROCESSING:PLOTMAF' {
        memory = { 12.GB * task.attempt }      // +24%
    }

    // peak_rss 9,800 MB (all_samples; 10 GB was only +2%)
    withName: 'BBGTOOLS:DEEPCSA:MUT_PREPROCESSING:WRITEMAF' {
        memory = { 12.GB * task.attempt }      // +25%
    }

    // peak_rss 2,900 MB (all_samples; 3 GB was only +3.4%)
    withName: 'BBGTOOLS:DEEPCSA:MUT_PREPROCESSING:PLOTNEEDLES' {
        memory = { 4.GB * task.attempt }       // +41%
    }

    // peak_rss 3,000 MB
    withName: 'BBGTOOLS:DEEPCSA:MUT_PREPROCESSING:PLOTSOMATICMAF' {
        memory = { 4.GB * task.attempt }       // +37%
    }

    // ==========================================================================
    // PLOTTING QC
    // ==========================================================================

    // Per-sample ≤ 19,500 MB (+16% at 22 GB); all_samples 21,800 MB (+10% at 24 GB)
    // 22 GB flat was only +3.3% over the all_samples peak.
    withName: 'BBGTOOLS:DEEPCSA:PLOTTINGQC:PLOTMUTATIONSPECIFIC' {
        memory = { (task.tag == 'all_samples' ? 24.GB : 22.GB) * task.attempt }
    }

    // ==========================================================================
    // MUTATION PROFILES
    // ==========================================================================

    // Per-sample ≤ 30 MB (+113% at 64 MB); all_samples 848 MB (+21% at 1 GB)
    withName: 'BBGTOOLS:DEEPCSA:MUTPROFILEALL:QUERYMUTATIONS' {
        memory = { (task.tag == 'all_samples' ? 1.GB : 64.MB) * task.attempt }
    }

    // Per-sample ≤ 108 MB (+137% at 256 MB); all_samples 846 MB (+21% at 1 GB)
    withName: 'BBGTOOLS:DEEPCSA:QUERYMUTATIONSEXONS' {
        memory = { (task.tag == 'all_samples' ? 1.GB : 256.MB) * task.attempt }
    }

    // Per-sample ≤ 168 MB (+52% at 256 MB); all_samples 2,800 MB (+46% at 4 GB)
    withName: 'BBGTOOLS:DEEPCSA:MUTPROFILEALL:SUBSETMUTPROFILE' {
        memory = { (task.tag == 'all_samples' ? 4.GB : 256.MB) * task.attempt }
    }

    // peak_rss 124–188 MB (all_samples == per-sample max)
    withName: 'BBGTOOLS:DEEPCSA:MUTPROFILEALL:COMPUTEMATRIX' {
        memory = { 256.MB * task.attempt }     // +36%
    }

    // peak_rss 311–470 MB (per-sample max > all_samples 438 MB)
    withName: 'BBGTOOLS:DEEPCSA:MUTPROFILEALL:COMPUTETRINUC' {
        memory = { 768.MB * task.attempt }     // +63% over 470 MB
    }

    // peak_rss 166–177 MB (per-sample max > all_samples 171 MB)
    withName: 'BBGTOOLS:DEEPCSA:MUTPROFILEALL:COMPUTEPROFILE' {
        memory = { 256.MB * task.attempt }     // +45%
    }

    // peak_rss 2,500 MB (single run)
    withName: 'BBGTOOLS:DEEPCSA:MUTPROFILEALL:CONCATPROFILES' {
        memory = { 3.GB * task.attempt }       // +23%
    }

    // ==========================================================================
    // SIGNATURES
    // ==========================================================================

    // peak_rss 5 MB
    withName: 'BBGTOOLS:DEEPCSA:SIGNATURESALL:MATRIXCONCATWGS' {
        memory = { 64.MB * task.attempt }
    }

    // peak_rss 974–1,002 MB (two runs: groups + samples matrix)
    withName: 'BBGTOOLS:DEEPCSA:SIGNATURESALL:SIGPROFILERASSIGNMENT' {
        memory = { 2.GB * task.attempt }       // +105%
    }

    // peak_rss 18 MB
    withName: 'BBGTOOLS:DEEPCSA:SIGNATURESALL:SIGPROBS' {
        memory = { 64.MB * task.attempt }
    }

    // peak_rss 479–480 MB (two runs)
    withName: 'BBGTOOLS:DEEPCSA:SIGNATURESALL:HDPREASSIGNMENT' {
        memory = { 768.MB * task.attempt }     // +60%
    }

    // peak_rss 50 MB
    withName: 'BBGTOOLS:DEEPCSA:SIGNATURESALL:HDPEXTRACTION:PREPARE_INPUT' {
        memory = { 64.MB * task.attempt }
    }

    // peak_rss 413–431 MB × 15 parallel chains
    withName: 'BBGTOOLS:DEEPCSA:SIGNATURESALL:HDPEXTRACTION:RUN_HDP_CHAIN_SAMPLING' {
        memory = { 768.MB * task.attempt }     // +78%
    }

    // peak_rss 731 MB
    withName: 'BBGTOOLS:DEEPCSA:SIGNATURESALL:HDPEXTRACTION:PROCESS_HDP_RESULTS' {
        memory = { 1.GB * task.attempt }       // +40%
    }

    // peak_rss 24 MB
    withName: 'BBGTOOLS:DEEPCSA:SIGNATURESALL:HDPEXTRACTION:REFORMATSIGNATURES' {
        memory = { 64.MB * task.attempt }
    }

    // peak_rss 184 MB
    withName: 'BBGTOOLS:DEEPCSA:SIGNATURESALL:HDPEXTRACTION:COMPARESIGNATURES' {
        memory = { 256.MB * task.attempt }
    }

    // peak_rss 345 MB
    withName: 'BBGTOOLS:DEEPCSA:SIGPROFILERASSIGNMENTINDELS' {
        memory = { 512.MB * task.attempt }     // +49%
    }

    // peak_rss 517 MB
    withName: 'BBGTOOLS:DEEPCSA:SIGPROMATRIXGENERATOR' {
        memory = { 1.GB * task.attempt }       // +98%
    }

    // Per-sample ≤ 213 MB (+20% at 256 MB); all_samples 3,400 MB (+21% at 4 GB)
    withName: 'BBGTOOLS:DEEPCSA:MUTS2SIGS' {
        memory = { (task.tag == 'all_samples' ? 4.GB : 256.MB) * task.attempt }
    }

    // ==========================================================================
    // ENRICHMENT
    // ==========================================================================

    // peak_rss 27,600 MB (28 GB was only +1.5%)
    withName: 'BBGTOOLS:DEEPCSA:ENRICHPANELS:DNA2PROTEINMAPPING' {
        memory = { 32.GB * task.attempt }      // +19%
    }

    // ==========================================================================
    // OMEGA / MUTRATE (no trace data from this run — conservative defaults)
    // ==========================================================================

    withName: 'BBGTOOLS:DEEPCSA:MUTRATE.*:MUTRATE.*' {
        memory = { 8.GB * task.attempt }
    }
    withName: 'BBGTOOLS:DEEPCSA:OMEGA.*:(PREPROCESSING|ESTIMATOR).*' {
        memory = { 4.GB * task.attempt }
    }
    withName: 'BBGTOOLS:DEEPCSA:OMEGA.*:ESTIMATOR_DNDSCV.*' {
        memory = { 2.GB * task.attempt }
    }
    withName: 'BBGTOOLS:DEEPCSA:OMEGA.*:ESTIMATOR_DRIVERMUTRATE.*' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'BBGTOOLS:DEEPCSA:OMEGANONPROT.*:SUBSETPANEL.*' {
        memory = { 4.GB * task.attempt }
    }
    withName: 'BBGTOOLS:DEEPCSA:SIGNATURESNONPROT:SIGPROFILERASSIGNMENT.*' {
        memory = { 2.GB * task.attempt }
    }

    // ==========================================================================
    // MISC / UTILITY
    // ==========================================================================

    // peak_rss 2,900 MB
    withName: 'BBGTOOLS:DEEPCSA:MAF2VCF' {
        memory = { 4.GB * task.attempt }       // +41%
    }

    // peak_rss 6 MB
    withName: 'BBGTOOLS:DEEPCSA:TABLE2GROUP' {
        memory = { 64.MB * task.attempt }
    }

    // peak_rss 1.5 MB
    withName: 'BBGTOOLS:DEEPCSA:INPUT_CHECK:SAMPLESHEET_CHECK' {
        memory = { 64.MB * task.attempt }
    }

    withName: 'BBGTOOLS:DEEPCSA:CUSTOM_DUMPSOFTWAREVERSIONS' {
        cache  = false
        memory = { 64.MB * task.attempt }      // peak_rss 8 MB
    }

    // peak_rss 70 MB
    withName: 'BBGTOOLS:DEEPCSA:MULTIQC' {
        memory = { 128.MB * task.attempt }
    }

    withName: 'BBGTOOLS:DEEPCSA:MUTATEDCELLSVAF:MUTATEDGENOMESFROMVAFAM' {
        errorStrategy = 'ignore'
        maxRetries    = 1
    }
    withName: 'COMPARE_SIGNATURES' {
        errorStrategy = 'ignore'
        maxRetries    = 1
    }
}
