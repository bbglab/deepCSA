/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for adding small patches to fix or ignore temporary issues
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    withName: 'DNA2PROTEINMAPPING' {
        errorStrategy = { task.attempt < 3 ? 'retry' : 'ignore' }
        maxRetries = 2
    }

    withName: 'COMPARE_SIGNATURES' {
        errorStrategy = 'ignore'
    }

    withName: 'MUTATEDGENOMESFROMVAFAM' {
        errorStrategy = 'ignore'
        maxRetries = 1
    }

    withName: "BBGTOOLS:DEEPCSA:EXPECTEDMUTATEDCELLS:.*" {
        errorStrategy = 'ignore'
        maxRetries = 1
    }


}
