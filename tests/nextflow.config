/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/

// config {
//     testsDir = '.'
//     workDir = System.getenv('NFT_WORKDIR') ?: '.nf-test'
//     configFile = 'tests/nextflow.config'
// }

profiles {
    submit_irbcluster {
        process {
            executor = 'slurm'
            queue = 'bbg_cpu_zen4,irb_cpu_zen4'
            errorStrategy = 'retry'
            maxRetries = 2
        }
    }
}

singularity {
   cacheDir = '/data/bbg/datasets/pipelines/nextflow_containers'
   libraryDir = '/data/bbg/datasets/pipelines/nextflow_containers'
   autoMounts = true
   runOptions = '-B /data/bbg'
}

executor {
   queueSize = 600
}

params {
    fasta = '/data/bbg/datasets/genomes/GRCh38/clean_n_fixed_genome/GCA_000001405.15_GRCh38_no_alt_analysis_set.masked.fna'
    domains_file = '/data/bbg/projects/prominent/dev/internal_development/domains/o3d_pfam_parsed.tsv'
    plot_only_allsamples = true
    confidence_level = 'med'
    sample_panel_min_depth = 40
    consensus_panel_min_depth = 500
    consensus_compliance = 0.8
    min_muts_per_sample = 0
    panel_with_canonical = true
    germline_threshold = 0.3
    mutation_depth_threshold = 40
    gnomad_af_threshold = 0.001
    repetitive_variant_thres = 5
    prop_samples_nrich = 0.1
    cosmic_ref_signatures = '/data/bbg/datasets/COSMIC_signatures/COSMIC_v3.4_SBS_GRCh38.txt'
    cadd_scores = '/data/bbg/datasets/CADD/v1.7/hg38/whole_genome_SNVs.tsv.gz'
    cadd_scores_ind = '/data/bbg/datasets/CADD/v1.7/hg38/whole_genome_SNVs.tsv.gz.tbi'
    dnds_ref_transcripts = '/data/bbg/projects/prominent/analysis/dNdScv/data/reference_files/RefCDS_human_latest_intogen.rda'
    dnds_covariates = '/data/bbg/projects/prominent/analysis/dNdScv/data/reference_files/covariates_hg19_hg38_epigenome_pcawg.rda'
    datasets3d = '/data/bbg/nobackup/scratch/oncodrive3d/datasets_240506'
    annotations3d = '/data/bbg/nobackup/scratch/oncodrive3d/annotations_240506'
    nanoseq_snp = '/data/bbg/datasets/genomes/GRCh38/masking_bedfiles/nanoseq_masks/SNP_GRCh38.wgns.bed.gz'
    nanoseq_noise = '/data/bbg/datasets/genomes/GRCh38/masking_bedfiles/nanoseq_masks/NOISE_GRCh38.wgns.bed.gz'
    vep_cache = '/data/bbg/datasets/vep'
    vep_genome = 'GRCh38'
    vep_species = 'homo_sapiens'
    vep_cache_version = 111
    vep_out_format = 'tab'
    vep_params = '--no_stats --cache --offline --symbol --protein --canonical --af_gnomadg --af_gnomade'
    vep_params_panel = '--no_stats --cache --offline --symbol --protein --canonical'
    response_and_total_subplots = true
    make2 = true
    correct_pvals = true
    sign_threshold = 0.05
    max_multiqc_email_size = '25.MB'
    publish_dir_mode = 'copy'
    validate_params = true
    n_mut_cutoff = 50
    sig_activity_threshold = 0
    cohort_threshold = 0
    burnin = 10000
    n_posterior = 100
    space = 200
    cpiter = 3
    iterations = 15
    cosine_sim_threshold = 0.9
    max_iter_em = 1000
    em_frac_threshold = 0.1
}
