/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/

// Load all cluster-specific reference paths (fasta, vep, cadd, nanoseq, etc.)
// wgs_trinuc_counts is overriden per-test with the data in assets/
includeConfig '../conf/general_files_IRB.config'

// TODO: Parameters in here were included before, do we need to include them?
includeConfig '../conf/tools/hdp_sig_extraction.config'

profiles {
    submit_irbcluster {
        process {
            executor = 'slurm'
            queue = 'bbg_cpu_zen4, irb_cpu_zen4'
            errorStrategy = 'retry'
            maxRetries = 2
        }
    }
}

singularity {
   cacheDir = '/data/bbg/datasets/pipelines/nextflow_containers'
   libraryDir = '/data/bbg/datasets/pipelines/nextflow_containers'
   autoMounts = true
   runOptions = '-B /data/bbg'
}

executor {
   queueSize = 600
}

params {
    // Outdir for test results
    outdir = "/scratch/bbg/work/deepCSA/nf-tests-outputs"

    config_profile_name        = 'Test profile'
    config_profile_description = 'Test dataset to check pipeline function'

    // TODO: check if we need to update these values for the test dataset.
    consensus_panel_min_depth = 500   // main default: 200 
    mutation_depth_threshold  = 40    // main default: 100

    // TODO: cosmic_ref_signatures is v3.4 here vs v3.5 in general_files_IRB.config.
    // If snapshots were generated with v3.4, keep this line. Otherwise remove it.
    // cosmic_ref_signatures = '/data/bbg/datasets/COSMIC_signatures/COSMIC_v3.4_SBS_GRCh38.txt'
}