/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/

// Load all cluster-specific reference paths (fasta, vep, cadd, nanoseq, etc.)
// wgs_trinuc_counts is overridden per-test with the data in assets/
includeConfig '../conf/general_files_IRB.config'

// config {
//     testsDir = '.'
//     workDir = System.getenv('NFT_WORKDIR') ?: '.nf-test'
//     configFile = 'tests/nextflow.config'
// }

profiles {
    submit_irbcluster {
        process {
            executor = 'slurm'
            queue = 'bbg_cpu_zen4,irb_cpu_zen4'
            errorStrategy = 'retry'
            maxRetries = 2
        }
    }
}

executor {
   queueSize = 600
}

singularity {
   cacheDir = '/data/bbg/datasets/pipelines/nextflow_containers'
   libraryDir = '/data/bbg/datasets/pipelines/nextflow_containers'
   autoMounts = true
   runOptions = '-B /data/bbg'
}

executor {
   queueSize = 600
}

// Skip nf-schema file-existence validation for params that receive remote HTTP URLs in tests.
validation {
    ignoreParams = ['input_maf', 'custom_depths_table']
}

process {
    // Override the 10m resourceLimits cap from the test profile to allow VEP to complete
    resourceLimits = [ cpus: 1, memory: 10.GB, time: 60.min ]
}

params {
    panel_sites_chunk_size                   = 0
}
