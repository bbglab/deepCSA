nextflow_process {
    name "Test WRITE_MAFS process"
    script "modules/local/writemaf/main.nf"
    process "WRITE_MAFS"

    test("Should run and emit grouped MAFs plus flagged positions") {
        when {
            process {
                """
                input[0] = tuple(
                    [id: 'all_samples'],
                    file("${projectDir}/test_data/modules/add_tests/processing_files/sumannotation/all_samples.vep.summary.tab.gz")
                )
                input[1] = file("${projectDir}/test_data/modules/add_tests/group_definition/samples/all_groups.json")
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}