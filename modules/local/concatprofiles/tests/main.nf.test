nextflow_process {
    name "Test CONCAT_PROFILES process"
    script "modules/local/concatprofiles/main.nf"
    process "CONCAT_PROFILES"

    test("Should run and reproduce expected mutational profile comparisons") {
        when {
            process {
                """
                input[0] = tuple(
                    [id: 'all_profiles'],
                    [
                        file("${projectDir}/test_data/modules/add_tests/mutational_profile/P19_0002_BDO_01.all.profile.tsv"),
                        file("${projectDir}/test_data/modules/add_tests/mutational_profile/P19_0002_BTR_01.all.profile.tsv"),
                        file("${projectDir}/test_data/modules/add_tests/mutational_profile/P19_0003_BDO_01.all.profile.tsv"),
                        file("${projectDir}/test_data/modules/add_tests/mutational_profile/all_samples.all.profile.tsv")
                    ]
                )
                input[1] = file("${projectDir}/test_data/modules/add_tests/group_definition/samples/all_groups.json")
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
