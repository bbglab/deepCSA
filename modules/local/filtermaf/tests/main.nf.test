nextflow_process {
    name "Test FILTER_BATCH process"
    script "modules/local/filtermaf/main.nf"
    process "FILTER_BATCH"

    test("Should run and emit cohort filtered mutations") {
        when {
            process {
                ext.repetitive_variant = 5
                ext.germline_threshold = 0.3
                ext.prop_samples_nrich = 0.1
                """
                input[0] = tuple(
                    [id: 'all_samples'],
                    file("${projectDir}/test_data/modules/add_tests/mutations/germline_somatic/all_samples.filtered.tsv.gz")
                )
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
