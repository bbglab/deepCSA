nextflow_process {
    name "Test FILTERDEPTHS process"
    script "modules/local/filterdepths/main.nf"
    process "FILTERDEPTHS"

    test("Should run and preserve depths when no minimum depth is set") {
        when {
            process {
                """
                input[0] = tuple(
                    [id: 'all_samples'],
                    file("${projectDir}/test_data/modules/add_tests/depths/all_samples_indv.depths.tsv.gz")
                )
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
