nextflow_process {
    name "Test MATRIX_CONCAT process"
    script "modules/local/sig_matrix_concat/main.nf"
    process "MATRIX_CONCAT"

    test("Should run and reproduce expected concatenated WGS matrices") {
        when {
            process {
                """
                input[0] = tuple(
                    [id: 'all_samples'],
                    [
                        file("${projectDir}/test_data/modules/add_tests/processing_files/computematrix/P19_0002_BDO_01.all.matrix.tsv.per_sample.sigprofiler"),
                        file("${projectDir}/test_data/modules/add_tests/processing_files/computematrix/P19_0002_BTR_01.all.matrix.tsv.per_sample.sigprofiler"),
                        file("${projectDir}/test_data/modules/add_tests/processing_files/computematrix/P19_0003_BDO_01.all.matrix.tsv.per_sample.sigprofiler"),
                        file("${projectDir}/test_data/modules/add_tests/processing_files/computematrix/all_samples.all.matrix.tsv.per_sample.sigprofiler")
                    ]
                )
                input[1] = file("${projectDir}/test_data/modules/add_tests/group_definition/samples/samples.json")
                """
            }
        }

        then {
            config {
                process {
                    withName: 'MATRIX_CONCAT' {
                        ext.prefix = '.all'
                    }
                }
            }
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
