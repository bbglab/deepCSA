nextflow_process {
    name "Test BLACKLIST_MUTATIONS process"
    script "modules/local/blacklistmuts/main.nf"
    process "BLACKLIST_MUTATIONS"

    test("Should run and remove blacklisted MUT_ID entries") {
        when {
            process {
                """
                input[0] = tuple(
                    [id: 'all_samples'],
                    file("${projectDir}/test_data/modules/add_tests/mutations/clean_somatic/all_samples.somatic.mutations.tsv")
                )
                input[1] = file("${projectDir}/test_data/modules/add_tests/processing_files/blacklist/mut_ids.txt")
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
