nextflow_process {
    name "Test FILTERBED process"
    script "modules/local/filterbed/main.nf"
    process "FILTERBED"

    test("Should run and annotate mutations in panel context") {
        when {
            process {
                """
                input[0] = tuple(
                    [id: 'all_samples'],
                    file("${projectDir}/test_data/modules/add_tests/mutations/clean_somatic/all_samples.somatic.mutations.tsv")
                )
                input[1] = tuple(
                    [id: 'PPM1D'],
                    file("${projectDir}/test_data/modules/PPM1D_exons.bed4.bed")
                )
                """
            }
        }

        then {
            config {
                process {
                    withName: 'FILTERBED' {
                        ext.filtername = 'not_in_panel'
                    }
                }
            }
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
